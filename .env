# Database configuration
ORDER_DB_DSN=host=orders-db port=5432 user=postgres password=postgres dbname=orders sslmode=disable
PAYMENT_DB_DSN=host=payments-db port=5432 user=postgres password=postgres dbname=payments sslmode=disable

# Service ports
ORDER_PORT=8080
ORDER_GRPC_PORT=50052
PAYMENT_PORT=8081
PAYMENT_GRPC_PORT=50051

# Service discovery and broker
PAYMENT_SERVICE_GRPC_HOST=payment-service
PAYMENT_SERVICE_GRPC_PORT=50051
NATS_URL=nats://nats:4222
REDIS_ADDR=redis:6379

# Notification provider configuration
PROVIDER_MODE=SIMULATED
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=

# Idempotency and retry configuration
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_TTL_SECONDS=30
MAX_NOTIFICATION_RETRIES=3
INITIAL_BACKOFF_SECONDS=2
